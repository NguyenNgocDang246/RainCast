                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/backtest.Comparison"
                    }
                },
                "duration": {
                    "type": "string"
                },
                "err_corr": {
                    "$ref": "#/definitions/backtest.ErrCorr"
                },
                "events": {
                    "description": "Events counts rain events (an hour or more of rain over the central\ntile) across regions: the independent cases the scores rest on.",
