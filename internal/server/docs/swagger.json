        "/api/forecast": {
            "get": {
                "description": "Answers with a Snapshot. When the server runs with client tiles, a GET may instead answer\n{\"tiles_needed\": TilePlan}: download every tile URL, then POST the same query as multipart,\none part per tile named \u003ctime\u003e_\u003cx\u003e_\u003cy\u003e (PNG bytes) or sum_\u003ctime\u003e_\u003cx\u003e_\u003cy\u003e (hex SHA-256 when it\nmatches the plan's sum). A POST answers the Snapshot, {\"tiles_missing\": [...]} (POST those\ntiles' bytes), or 409 with a new plan when a newer radar frame arrived.",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "forecast"
                ],
                "summary": "Rain forecast for a point",
                "parameters": [
                    {
                        "type": "number",
                        "description": "Latitude (±85)",
                        "name": "lat",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "number",
                        "description": "Longitude (±180)",
                        "name": "lon",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Content hash of tiles the client has (GET, cached forecast)",
                        "name": "h",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/pipeline.Snapshot"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/server.errorResponse"
                        }
                    },
                    "409": {
                        "description": "Radar frames changed; download the new tiles",
                        "schema": {
                            "$ref": "#/definitions/server.TilesNeeded"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/server.errorResponse"
                        }
                    },
                    "503": {
                        "description": "Radar data is still loading",
                        "schema": {
                            "$ref": "#/definitions/server.errorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Answers with a Snapshot. When the server runs with client tiles, a GET may instead answer\n{\"tiles_needed\": TilePlan}: download every tile URL, then POST the same query as multipart,\none part per tile named \u003ctime\u003e_\u003cx\u003e_\u003cy\u003e (PNG bytes) or sum_\u003ctime\u003e_\u003cx\u003e_\u003cy\u003e (hex SHA-256 when it\nmatches the plan's sum). A POST answers the Snapshot, {\"tiles_missing\": [...]} (POST those\ntiles' bytes), or 409 with a new plan when a newer radar frame arrived.",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "forecast"
                ],
                "summary": "Rain forecast for a point",
                "parameters": [
                    {
                        "type": "number",
                        "description": "Latitude (±85)",
                        "name": "lat",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "number",
                        "description": "Longitude (±180)",
                        "name": "lon",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Content hash of tiles the client has (GET, cached forecast)",
                        "name": "h",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/pipeline.Snapshot"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/server.errorResponse"
                        }
                    },
                    "409": {
                        "description": "Radar frames changed; download the new tiles",
                        "schema": {
                            "$ref": "#/definitions/server.TilesNeeded"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/server.errorResponse"
                        }
                    },
                    "503": {
                        "description": "Radar data is still loading",
                        "schema": {
                            "$ref": "#/definitions/server.errorResponse"
                        }
                    }
                }
            }
        },
