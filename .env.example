# Copy to .env for local runs (cmd/raincast, cmd/collect, cmd/backtest,
# docker compose). Real environment variables take precedence. On Vercel set
# the variables in the project settings instead (see the end of this file).

# "development" (default for local runs) or "production" (default on
# Vercel). Production serves no admin page, needs CORS_ORIGIN spelled out
# and logs JSON.
APP_ENV=development

# Geoapify key for address search and the map (free plan: 3000 credits/day,
# 5 req/s). Get one at https://myprojects.geoapify.com. It stays on the
# server: the browser gets map tiles through /api/tiles.
GEOAPIFY_KEY=

# The collector's PostgreSQL (docker-compose.yml's db service), read by
# cmd/backtest and by the local admin page. Not used on Vercel.
DATABASE_URL=postgres://raincast:raincast@localhost:5432/raincast?sslmode=disable

# Redis sharing computed forecasts between API instances: locally the
# docker-compose.yml redis service, on Vercel e.g. Upstash (rediss://…).
# Empty: each instance caches in its own memory.
REDIS_URL=redis://localhost:6379

# --- Vercel ---
# API project (repo root): APP_ENV=production, GEOAPIFY_KEY, REDIS_URL
# (optional), CORS_ORIGIN=https://<web-project>.vercel.app
# Web project (root web/): NEXT_PUBLIC_API_BASE=https://<api-project>.vercel.app
