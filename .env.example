# Copy to .env and fill in. Real environment variables take precedence.

# LocationIQ key for fast address suggestions (free plan: 2 req/s).
# Get one at https://locationiq.com. Empty = use the slower public Photon.
LOCATIONIQ_KEY=

# --- Deploy (docker-compose.yml / Caddyfile) ---

# ":80" = plain HTTP on the server's IP. A host name gets HTTPS automatically,
# e.g. "203.0.113.7.sslip.io" (free, no domain to buy) or your own domain.
SITE_ADDRESS=:80

# Login for /admin. Hash the password with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains "$".
ADMIN_USER=admin
ADMIN_HASH=''
